# =============================================================================
# Beam Cloud AI Service Configuration (Noventra Labs)
# =============================================================================
PORT=8080
ENVIRONMENT=production

# 1. Supabase Encrypted API Key Vault Configuration
# Run supabase_schema.sql in your Supabase SQL Editor to create `public.beam_api_keys`
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
VAULT_ENCRYPTION_SECRET=change-this-to-a-strong-32-char-secret-key

# 2. Optional Fallback Provider API Keys (Used if not stored in Supabase yet)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
