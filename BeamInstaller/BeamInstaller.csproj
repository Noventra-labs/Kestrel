<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Kestrel-Setup</AssemblyName>
    <RootNamespace>BeamInstaller</RootNamespace>
    <ApplicationIcon>..\Beam\beam.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.3.1</Version>
    <FileVersion>2.3.1.0</FileVersion>
    <AssemblyVersion>2.3.1.0</AssemblyVersion>
    <Company>Noventra-Labs</Company>
    <Authors>Noventra-Labs</Authors>
    <Product>Kestrel Setup Wizard</Product>
    <AssemblyTitle>Kestrel Setup — Noventra-Labs</AssemblyTitle>
    <Copyright>Copyright © 2026 Noventra-Labs. All rights reserved.</Copyright>
    <Description>Official Standalone Windows Installer for Kestrel by Noventra-Labs</Description>
    <RepositoryUrl>https://github.com/Noventra-labs/Kestrel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Noventra-labs/Kestrel</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\Beam\beam.ico" Link="beam.ico" />
    <EmbeddedResource Include="..\Beam\publish\Kestrel.exe" LogicalName="Payload.Kestrel.exe" />
    <EmbeddedResource Include="..\Beam\beam.ico" LogicalName="Payload.beam.ico" />
  </ItemGroup>

</Project>
