<Window x:Class="BeamInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kestrel Setup — Noventra-Labs"
        Width="520" Height="370"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Icon="beam.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Minimal Modern Checkbox Style -->
        <Style x:Key="MinimalCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="BoxBorder"
                                    Width="17" Height="17"
                                    CornerRadius="4"
                                    Background="#161922"
                                    BorderBrush="#32394A"
                                    BorderThickness="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Width="10" Height="8"
                                      Stretch="Uniform"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 1,4 L 4,7 L 9,1"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FF6363" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF6363" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF8080" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Rounded Card -->
    <Border Background="#101218"
            BorderBrush="#242938"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- Top Minimal Drag Title Bar -->
            <Border Grid.Row="0"
                    Background="#0C0E13"
                    BorderBrush="#1A1E29"
                    BorderThickness="0,0,0,1"
                    Padding="16,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="11" Height="11" Stretch="Uniform" Fill="#FF6363" Margin="0,0,8,0"
                              Data="M 0,6 L 6,0 L 12,6 L 6,12 Z" />
                        <TextBlock Text="Kestrel Setup" Foreground="#9CA3AF" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border HorizontalAlignment="Right"
                            Width="24" Height="24"
                            CornerRadius="5"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseLeftButtonDown="BtnSecondary_Click">
                        <TextBlock Text="✕" Foreground="#6B7280" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Center Content Area -->
            <Grid Grid.Row="1" Margin="28,22,28,16">

                <!-- ========================================================= -->
                <!-- VIEW 1: MINIMAL SINGLE-PAGE SETUP                         -->
                <!-- ========================================================= -->
                <StackPanel x:Name="PageSetup" Visibility="Visible">
                    <!-- Brand Header -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#1FFF6363" BorderBrush="#55FF6363" BorderThickness="1" Margin="0,0,14,0">
                            <Path Width="22" Height="22" Stretch="Uniform" Fill="#FF6363" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0,10 L 10,0 L 20,10 L 10,20 Z M 4.5,10 L 10,4.5 L 15.5,10 L 10,15.5 Z" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kestrel" Foreground="#F9FAFB" FontSize="19" FontWeight="Bold" />
                                <Border Background="#1C202C" BorderBrush="#2B3142" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v2.3.1" Foreground="#9CA3AF" FontSize="10.5" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Fast, native command bar and launcher for Windows." Foreground="#9CA3AF" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Destination Folder -->
                    <TextBlock Text="INSTALL LOCATION" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="2,0,0,6" />
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallDir"
                                 Grid.Column="0"
                                 Background="#151821"
                                 Foreground="#D1D5DB"
                                 CaretBrush="#FF6363"
                                 BorderBrush="#242A38"
                                 BorderThickness="1"
                                 Padding="10,7"
                                 FontSize="12" />
                        <Border Grid.Column="1"
                                Background="#1B202C"
                                BorderBrush="#2D3446"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,7"
                                Margin="8,0,0,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="BrowseFolder_Click">
                            <TextBlock Text="Change" Foreground="#E5E7EB" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Minimal Essential Options -->
                    <TextBlock Text="OPTIONS" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="2,0,0,8" />
                    <Border Background="#141720" BorderBrush="#212634" BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel>
                            <CheckBox x:Name="OptLaunchOnBoot"
                                      Style="{StaticResource MinimalCheckBoxStyle}"
                                      Content="Launch automatically at Windows sign-in"
                                      Margin="0,0,0,9"
                                      IsChecked="True" />

                            <CheckBox x:Name="OptConfigureWinHook"
                                      Style="{StaticResource MinimalCheckBoxStyle}"
                                      Content="Enable Windows Key &amp; Alt + Space global shortcuts"
                                      Margin="0,0,0,9"
                                      IsChecked="True" />

                            <CheckBox x:Name="OptCreateShortcuts"
                                      Style="{StaticResource MinimalCheckBoxStyle}"
                                      Content="Create Desktop &amp; Start Menu shortcuts"
                                      IsChecked="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========================================================= -->
                <!-- VIEW 2: SMOOTH INSTALLATION PROGRESS UX                   -->
                <!-- ========================================================= -->
                <StackPanel x:Name="PageInstalling" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                    <Border Width="48" Height="48" CornerRadius="13" Background="#1FFF6363" BorderBrush="#55FF6363" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Width="22" Height="22" Stretch="Uniform" Fill="#FF6363" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0,10 L 10,0 L 20,10 L 10,20 Z M 4.5,10 L 10,4.5 L 15.5,10 L 10,15.5 Z" />
                    </Border>

                    <TextBlock x:Name="InstallingHeaderTitle"
                               Text="Installing Kestrel..."
                               Foreground="#F9FAFB"
                               FontSize="17"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6" />

                    <TextBlock x:Name="InstallingStepLabel"
                               Text="Preparing files..."
                               Foreground="#9CA3AF"
                               FontSize="12.5"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />

                    <!-- Sleek Progress Track -->
                    <Border Width="380"
                            Height="7"
                            CornerRadius="3.5"
                            Background="#191D28"
                            BorderBrush="#252B3B"
                            BorderThickness="1"
                            ClipToBounds="True"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                        <Border x:Name="InstallProgressFill"
                                HorizontalAlignment="Left"
                                Width="0"
                                Height="7"
                                CornerRadius="3.5"
                                Background="#FF6363" />
                    </Border>

                    <TextBlock x:Name="InstallPercentText"
                               Text="0%"
                               Foreground="#6B7280"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />

                    <!-- Failure Diagnostic Card (Shown only in step 4) -->
                    <Border x:Name="FailureDetailBox"
                            Visibility="Collapsed"
                            Background="#151821"
                            BorderBrush="#2B3142"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="FailureDiagnosticText"
                                       Text="A conflicting process or file restriction was encountered. Click 'Retry &amp; Auto-Fix' to terminate conflicts, repair permissions, and finish setup automatically."
                                       Foreground="#9CA3AF"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========================================================= -->
                <!-- VIEW 3: READY / COMPLETED VIEW                            -->
                <!-- ========================================================= -->
                <StackPanel x:Name="PageComplete" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                    <Border Width="48" Height="48" CornerRadius="13" Background="#1A10B981" BorderBrush="#4D10B981" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Path Width="20" Height="16" Stretch="Uniform" Stroke="#34D399" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 2,9 L 7,14 L 18,3" />
                    </Border>

                    <TextBlock Text="Kestrel is ready"
                               Foreground="#F9FAFB"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6" />

                    <TextBlock x:Name="CompleteSummaryText"
                               Text="Installed and configured in your Windows System Tray."
                               Foreground="#9CA3AF"
                               FontSize="12.5"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18" />

                    <Border Background="#151821" BorderBrush="#232836" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Summon Launcher" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right" Background="#1E2330" BorderBrush="#2F374A" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="Win Key  or  Alt + Space" Foreground="#F3F4F6" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Preferences" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right" Background="#1E2330" BorderBrush="#2F374A" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="Ctrl + ," Foreground="#F3F4F6" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="ChkLaunchNow"
                              Style="{StaticResource MinimalCheckBoxStyle}"
                              Content="Launch Kestrel now"
                              HorizontalAlignment="Center"
                              IsChecked="True" />
                </StackPanel>
            </Grid>

            <!-- Bottom Action Bar -->
            <Border Grid.Row="2" Background="#0C0E13" BorderBrush="#1C202B" BorderThickness="0,1,0,0" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="Noventra-Labs" Foreground="#6B7280" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NoventraLink_Click" ToolTip="Visit https://github.com/Noventra-labs/Kestrel" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Secondary Action (Cancel / Back) -->
                        <Border x:Name="BtnSecondary"
                                Background="#171B24"
                                BorderBrush="#282F3E"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,7"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="BtnSecondary_Click">
                            <TextBlock x:Name="TxtSecondaryBtn" Text="Cancel" Foreground="#9CA3AF" FontSize="12" FontWeight="Medium" />
                        </Border>

                        <!-- Primary Action (Install / Finish / Retry) - Unified Brand Color -->
                        <Border x:Name="BtnPrimary"
                                Background="#FF6363"
                                CornerRadius="6"
                                Padding="20,7"
                                Cursor="Hand"
                                MouseLeftButtonDown="BtnPrimary_Click">
                            <TextBlock x:Name="TxtPrimaryBtn" Text="Install Kestrel" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
