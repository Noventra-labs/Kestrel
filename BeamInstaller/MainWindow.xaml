<Window x:Class="BeamInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beam v2.3.0 Setup — Noventra Labs"
        Width="680" Height="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#111318"
        Icon="beam.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <!-- Main Content Area (Left Brand Sidebar + Right Wizard Step Pages) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Brand Banner (Noventra Labs) -->
            <Border Grid.Column="0" Background="#161922" BorderBrush="#252B3B" BorderThickness="0,0,1,0" Padding="22,26">
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <!-- Glowing Diamond Icon -->
                        <Border Width="52" Height="52" CornerRadius="14" Background="#24FF6363" BorderBrush="#66FF6363" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <Path Width="26" Height="26" Stretch="Uniform" Fill="#FF6363" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0,10 L 10,0 L 20,10 L 10,20 Z M 4.5,10 L 10,4.5 L 15.5,10 L 10,15.5 Z" />
                        </Border>

                        <TextBlock Text="Beam" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Version 2.3.0 (64-bit)" Foreground="#9CA3AF" FontSize="12" Margin="0,2,0,4" />
                        <Border Background="#232938" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" Margin="0,2,0,24">
                            <TextBlock Text="Noventra Labs" Foreground="#FF8585" FontSize="11" FontWeight="SemiBold" />
                        </Border>

                        <!-- Wizard Step Indicators -->
                        <StackPanel>
                            <TextBlock x:Name="StepIndicator1" Text="●  1. Welcome &amp; License" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock x:Name="StepIndicator2" Text="○  2. Install Options" Foreground="#6B7280" FontSize="12.5" Margin="0,0,0,10" />
                            <TextBlock x:Name="StepIndicator3" Text="○  3. Installing Files" Foreground="#6B7280" FontSize="12.5" Margin="0,0,0,10" />
                            <TextBlock x:Name="StepIndicator4" Text="○  4. Finish Setup" Foreground="#6B7280" FontSize="12.5" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock VerticalAlignment="Bottom"
                               Text="© 2026 Noventra Labs&#x0a;Official Windows Installer"
                               Foreground="#6B7280"
                               FontSize="11"
                               LineHeight="16" />
                </Grid>
            </Border>

            <!-- Right Wizard Pages -->
            <Grid Grid.Column="1" Margin="28,24,28,20">
                <!-- ========================================================= -->
                <!-- PAGE 1: WELCOME & LICENSE AGREEMENT                       -->
                <!-- ========================================================= -->
                <StackPanel x:Name="PageWelcome" Visibility="Visible">
                    <TextBlock Text="Welcome to the Beam Setup Wizard" Foreground="#F9FAFB" FontSize="19" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="This wizard will install Beam v2.3.0 (published by Noventra Labs) on your computer."
                               Foreground="#9CA3AF" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <TextBlock Text="END-USER SOFTWARE LICENSE &amp; FEATURE OVERVIEW" Foreground="#FF6363" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                    <Border Background="#161922" BorderBrush="#282F3F" BorderThickness="1" CornerRadius="7" Height="175" Padding="12,10" Margin="0,0,0,14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Foreground="#D1D5DB" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                       Text="Beam Launcher for Windows&#x0a;Publisher: Noventra Labs&#x0a;Version: 2.3.0 (Windows 10 / 11 x64)&#x0a;&#x0a;Included Features:&#x0a;• Global Start Key (Windows Key) &amp; Alt+Space Launcher&#x0a;• Embedded Google Gemini AI Chat (WebView2 &amp; Fast API Stream)&#x0a;• Raycast Fuzzy + Acronym Search &amp; Frecency Learning&#x0a;• 15 Window Management Snapping Layouts (DWM Frame Compensated)&#x0a;• Zero-CPU Event-Driven Clipboard History Manager &amp; Auto-Paste&#x0a;• Instant Local File Search Indexer (Ctrl+F)&#x0a;• Smart Calculator, Unit, Currency &amp; World Timezone Converter&#x0a;&#x0a;By installing this software, you agree to the Noventra Labs End-User License Agreement. This software is provided by Noventra Labs for personal and commercial productivity use on Windows." />
                        </ScrollViewer>
                    </Border>

                    <CheckBox x:Name="ChkAcceptLicense"
                              Content="I accept the terms in the Noventra Labs License Agreement"
                              Foreground="#F9FAFB"
                              FontSize="13"
                              IsChecked="True"
                              Checked="ChkAcceptLicense_Changed"
                              Unchecked="ChkAcceptLicense_Changed" />
                </StackPanel>

                <!-- ========================================================= -->
                <!-- PAGE 2: DESTINATION FOLDER & SHORTCUT OPTIONS             -->
                <!-- ========================================================= -->
                <StackPanel x:Name="PageOptions" Visibility="Collapsed">
                    <TextBlock Text="Destination Folder &amp; Shortcuts" Foreground="#F9FAFB" FontSize="19" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="Select where Noventra Labs Beam should be installed and choose your startup preferences."
                               Foreground="#9CA3AF" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <TextBlock Text="INSTALLATION FOLDER" Foreground="#FF6363" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallDir"
                                 Grid.Column="0"
                                 Background="#181C26"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#323A4E"
                                 BorderThickness="1"
                                 Padding="10,6"
                                 FontSize="12.5" />
                        <Button Grid.Column="1"
                                Content="Browse..."
                                Margin="8,0,0,0"
                                Padding="14,6"
                                Background="#252C3D"
                                Foreground="#FFFFFF"
                                BorderBrush="#3B455E"
                                Cursor="Hand"
                                Click="BrowseFolder_Click" />
                    </Grid>

                    <TextBlock Text="ADDITIONAL TASKS &amp; INTEGRATION" Foreground="#FF6363" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />

                    <CheckBox x:Name="OptDesktopShortcut"
                              Content="Create a Desktop shortcut for Beam"
                              Foreground="#F9FAFB" FontSize="13" Margin="0,0,0,9" IsChecked="True" />

                    <CheckBox x:Name="OptStartMenuShortcut"
                              Content="Create a Start Menu Programs shortcut (Noventra Labs \ Beam)"
                              Foreground="#F9FAFB" FontSize="13" Margin="0,0,0,9" IsChecked="True" />

                    <CheckBox x:Name="OptLaunchOnBoot"
                              Content="Launch Beam automatically when Windows starts (Keep alive in System Tray)"
                              Foreground="#F9FAFB" FontSize="13" Margin="0,0,0,9" IsChecked="True" />

                    <CheckBox x:Name="OptConfigureWinHook"
                              Content="Enable Start Button (Windows Key) &amp; Alt+Space global hook optimization"
                              Foreground="#F9FAFB" FontSize="13" Margin="0,0,0,9" IsChecked="True" />

                    <CheckBox x:Name="OptRegisterUninstall"
                              Content="Register in Windows Installed Apps (Publisher: Noventra Labs)"
                              Foreground="#F9FAFB" FontSize="13" IsChecked="True" />
                </StackPanel>

                <!-- ========================================================= -->
                <!-- PAGE 3: INSTALLING PROGRESS & ACTIVITY LOG                -->
                <!-- ========================================================= -->
                <StackPanel x:Name="PageInstalling" Visibility="Collapsed">
                    <TextBlock x:Name="InstallingHeaderTitle" Text="Installing Beam..." Foreground="#F9FAFB" FontSize="19" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock x:Name="InstallingStepLabel" Text="Preparing installation package..." Foreground="#9CA3AF" FontSize="12.5" Margin="0,0,0,14" />

                    <ProgressBar x:Name="InstallProgressBar"
                                 Height="14"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="#1A1E29"
                                 Foreground="#FF6363"
                                 BorderBrush="#2E3648"
                                 Margin="0,0,0,14" />

                    <Border Background="#161922" BorderBrush="#282F3F" BorderThickness="1" CornerRadius="7" Height="185" Padding="10">
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="InstallLogText"
                                       Foreground="#D1D5DB"
                                       FontFamily="Consolas, Segoe UI"
                                       FontSize="11.5"
                                       LineHeight="17"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- ========================================================= -->
                <!-- PAGE 4: COMPLETED SETUP WIZARD                            -->
                <!-- ========================================================= -->
                <StackPanel x:Name="PageComplete" Visibility="Collapsed">
                    <TextBlock Text="Completed the Beam Setup Wizard" Foreground="#F9FAFB" FontSize="19" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock x:Name="CompleteSummaryText"
                               Text="Beam v2.3.0 by Noventra Labs has been successfully installed on your computer."
                               Foreground="#D1D5DB" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,18" />

                    <Border Background="#161922" BorderBrush="#282F3F" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Quick Keyboard Shortcuts:" Foreground="#FF6363" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="• Tap [Windows Key] or press [Alt + Space] → Open / Toggle Beam" Foreground="#E5E7EB" FontSize="12.5" Margin="0,0,0,4" />
                            <TextBlock Text="• Type 'gemini' or press [Tab] → Open Embedded Google Gemini Chat" Foreground="#E5E7EB" FontSize="12.5" Margin="0,0,0,4" />
                            <TextBlock Text="• Press [Ctrl + ,] → Open Preferences &amp; Feature Control Center" Foreground="#E5E7EB" FontSize="12.5" />
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="ChkLaunchNow"
                              Content="Launch Beam now (Start in System Tray &amp; Open Launcher)"
                              Foreground="#F9FAFB"
                              FontSize="13.5"
                              FontWeight="SemiBold"
                              IsChecked="True" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Bottom Wizard Navigation Bar -->
        <Border Grid.Row="1" Background="#0D0F14" BorderBrush="#222734" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="Noventra Labs Installer Engine v2.3" Foreground="#6B7280" FontSize="11.5" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnBack"
                            Content="&lt; Back"
                            Width="88" Height="32"
                            Margin="0,0,8,0"
                            Background="#1E2330"
                            Foreground="#E5E7EB"
                            BorderBrush="#32394C"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="BtnBack_Click" />

                    <Button x:Name="BtnNext"
                            Content="Next &gt;"
                            Width="104" Height="32"
                            Margin="0,0,8,0"
                            Background="#FF6363"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            BorderBrush="#FF8080"
                            Cursor="Hand"
                            Click="BtnNext_Click" />

                    <Button x:Name="BtnCancel"
                            Content="Cancel"
                            Width="84" Height="32"
                            Background="#1E2330"
                            Foreground="#9CA3AF"
                            BorderBrush="#32394C"
                            Cursor="Hand"
                            Click="BtnCancel_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

