<Window x:Class="Kestrel.Views.TextExtractorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kestrel Text Extractor (Screen OCR)"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#35000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp">

    <Canvas x:Name="OverlayCanvas">
        <!-- Floating Instruction Pill -->
        <Border x:Name="HintPill"
                Background="#CC0A0D14"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✦ Text Extractor"
                           FontWeight="SemiBold"
                           Foreground="#FF6363"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Text=" • Drag over text to copy • Esc to cancel"
                           Foreground="#E2E8F0"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Dynamic Drag Selection Rectangle -->
        <Rectangle x:Name="SelectionRectangle"
                   Stroke="#FF6363"
                   StrokeThickness="1.5"
                   Fill="#28FF6363"
                   RadiusX="4" RadiusY="4"
                   Visibility="Collapsed" />
    </Canvas>
</Window>
