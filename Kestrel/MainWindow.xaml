<Window x:Class="Kestrel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kestrel"
        Width="680" Height="452"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{x:Null}"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="kestrel.ico"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BrandRed" Color="#FF6363" />
        <SolidColorBrush x:Key="BrandAccentTint" Color="#24FF6363" />
        <SolidColorBrush x:Key="BrandAccentBorder" Color="#55FF6363" />
        <SolidColorBrush x:Key="BrandAccentSelection" Color="#44FF6363" />
        <SolidColorBrush x:Key="BrandAccentSoft" Color="#FF9494" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />

        <!-- Smoked Glass Shell Gradient (over Windows 11 DWM Acrylic) -->
        <LinearGradientBrush x:Key="GlassShellFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3A090C12" Offset="0" />
            <GradientStop Color="#4407090E" Offset="0.55" />
            <GradientStop Color="#4E05070B" Offset="1" />
        </LinearGradientBrush>

        <!-- Directional Specular Glass Rim -->
        <LinearGradientBrush x:Key="GlassSpecularBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#52FFFFFF" Offset="0" />
            <GradientStop Color="#20FFFFFF" Offset="0.4" />
            <GradientStop Color="#10FFFFFF" Offset="0.75" />
            <GradientStop Color="#28FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <!-- Minimal Frosted Keycap Brush -->
        <SolidColorBrush x:Key="GlassChipFill" Color="#0EFFFFFF" />
        <SolidColorBrush x:Key="GlassChipBorder" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="GlassCardFill" Color="#08FFFFFF" />
        <SolidColorBrush x:Key="GlassCardBorder" Color="#18FFFFFF" />

        <!-- Ultra-Thin Glass ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="4" Margin="0,6,4,6">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#38FFFFFF" CornerRadius="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist Glass Toggle Switch -->
        <Style x:Key="RaycastSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="38" Height="20"
                                CornerRadius="10"
                                Background="#1AFFFFFF"
                                BorderBrush="#2EFFFFFF"
                                BorderThickness="1"
                                Padding="2">
                            <Ellipse x:Name="Knob"
                                     Width="14" Height="14"
                                     Fill="#CBD5E1"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrandRed}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrandAccentBorder}" />
                                <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Frosted Glass Result Capsule -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="10,1.5,10,1.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="10"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="10,6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="ActiveBar"
                                        Width="2.5" Height="18"
                                        CornerRadius="1.5"
                                        Background="{DynamicResource BrandRed}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="-6,0,0,0"
                                        Visibility="Collapsed" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#13FFFFFF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#28FFFFFF" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#08FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Flush Outer Glass Shell (Windows 11 DWM Acrylic + Smoked Specular Surface) -->
    <Border x:Name="MainShellBorder"
            CornerRadius="16"
            Background="{StaticResource GlassShellFill}"
            BorderBrush="{StaticResource GlassSpecularBorder}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <!-- Top Specular Edge Highlight -->
            <Border Height="1" VerticalAlignment="Top" Margin="24,0,24,0" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#44FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ========================================================================= -->
            <!-- LAYER 1: Minimalist Glass Launcher                                        -->
            <!-- ========================================================================= -->
            <Grid x:Name="LauncherView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />   <!-- 0: Search Omnibar -->
                    <RowDefinition Height="36" />   <!-- 1: Minimal Filter Strip -->
                    <RowDefinition Height="*" />    <!-- 2: Results List -->
                    <RowDefinition Height="38" />   <!-- 3: Minimal Footer -->
                </Grid.RowDefinitions>

                <!-- Row 0: Frosted Omnibar Header -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#14FFFFFF" Background="#05FFFFFF">
                    <Grid Margin="18,0,18,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Back Button (Sub-modes) -->
                        <Border x:Name="BackButtonBorder"
                                Grid.Column="0"
                                Visibility="Collapsed"
                                Background="{StaticResource GlassChipFill}"
                                BorderBrush="{StaticResource GlassChipBorder}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Width="26" Height="26"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="BackButton_Click">
                            <TextBlock Text="←" Foreground="#F8FAFC" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Border>

                        <!-- Minimal Kestrel Emblem -->
                        <Path x:Name="BrandLogoPath"
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Fill="{DynamicResource BrandRed}"
                              Cursor="Hand"
                              MouseLeftButtonDown="BrandLogo_Click"
                              Data="M 0,10 L 10,0 L 20,10 L 10,20 Z M 4.5,10 L 10,4.5 L 15.5,10 L 10,15.5 Z" />

                        <!-- Active Sub-View Pill -->
                        <Border x:Name="ActiveModePill"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Background="{DynamicResource BrandAccentTint}"
                                BorderBrush="{DynamicResource BrandAccentBorder}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="8,3"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveModeText"
                                       Text="Clipboard"
                                       Foreground="{DynamicResource BrandAccentSoft}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold" />
                        </Border>

                        <!-- Search Input -->
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="PlaceholderText"
                                       Text="Search apps, commands, or files..."
                                       Foreground="#7A94A3B8"
                                       FontSize="16.5"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Margin="2,0,0,0" />
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FocusVisualStyle="{x:Null}"
                                     Foreground="{StaticResource TextPrimary}"
                                     CaretBrush="{DynamicResource BrandRed}"
                                     SelectionBrush="{DynamicResource BrandAccentSelection}"
                                     FontSize="16.5"
                                     FontWeight="Normal"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     AcceptsReturn="False" />
                        </Grid>

                        <!-- Right: Minimal AI Trigger Pill -->
                        <Border x:Name="QuickAiBadgeBorder"
                                Grid.Column="3"
                                Background="{StaticResource GlassCardFill}"
                                BorderBrush="{StaticResource GlassCardBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="9,4"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                MouseLeftButtonDown="QuickAiBadge_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✦ AI"
                                           Foreground="#E2E8F0"
                                           FontSize="11.5"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <Border Background="#18FFFFFF"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="5,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Tab"
                                               Foreground="#FF8585"
                                               FontSize="10.5"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Row 1: Minimalist Frosted Category Pills -->
                <Grid Grid.Row="1" Margin="16,0,18,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="FilterTabsPanel"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border x:Name="TabAll" Background="#1EFFFFFF" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="7" Padding="10,2.5" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="FilterTab_Click" Tag="All">
                            <TextBlock Text="All" Foreground="#F8FAFC" FontSize="11.5" FontWeight="SemiBold" />
                        </Border>
                        <Border x:Name="TabApps" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="10,2.5" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="FilterTab_Click" Tag="Application">
                            <TextBlock Text="Apps" Foreground="#94A3B8" FontSize="11.5" />
                        </Border>
                        <Border x:Name="TabCommands" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="10,2.5" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="FilterTab_Click" Tag="Command">
                            <TextBlock Text="Commands" Foreground="#94A3B8" FontSize="11.5" />
                        </Border>
                        <Border x:Name="TabWindows" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="10,2.5" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="FilterTab_Click" Tag="Window Management">
                            <TextBlock Text="Windows" Foreground="#94A3B8" FontSize="11.5" />
                        </Border>
                        <Border x:Name="TabSystem" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="10,2.5" Cursor="Hand" MouseLeftButtonDown="FilterTab_Click" Tag="System">
                            <TextBlock Text="System" Foreground="#94A3B8" FontSize="11.5" />
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="SectionHeaderText"
                               Grid.Column="2"
                               Text=""
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Row 2: Clean Path-Free Results List -->
                <ListBox x:Name="ResultsList"
                         Grid.Row="2"
                         Background="Transparent"
                         BorderThickness="0"
                         Focusable="False"
                         IsTextSearchEnabled="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLength="16,16"
                         VirtualizingPanel.CacheLengthUnit="Item"
                         SelectionMode="Single"
                         SelectionChanged="ResultsList_SelectionChanged"
                         PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
                         MouseDoubleClick="ResultsList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="30" VerticalAlignment="Center" Margin="4,0,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- High-DPI App or Squircle Vector Icon -->
                                <Image Grid.Column="0"
                                       Source="{Binding Icon}"
                                       Width="22" Height="22"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <!-- Primary Title -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13.5"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />

                                <!-- Optional Non-Path Inline Detail (Auto-Collapsed When Empty) -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Subtitle}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="10,0,10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Subtitle}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Right-Aligned Single Minimal Pill (Shortcut Keycap OR Quiet Category) -->
                                <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border Background="{StaticResource GlassChipFill}"
                                            BorderBrush="{StaticResource GlassChipBorder}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="7,1.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShortcutBadge}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShortcutBadge}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ShortcutBadge}"
                                                   Foreground="#CBD5E1"
                                                   FontSize="10.5"
                                                   FontWeight="Medium" />
                                    </Border>

                                    <TextBlock Text="{Binding Category}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Margin="0,0,2,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShortcutBadge}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShortcutBadge}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Row 3: Minimal Frosted Status Bar -->
                <Border Grid.Row="3"
                        Background="#1205070B"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#14FFFFFF"
                        CornerRadius="0,0,16,16"
                        Padding="18,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Status -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource BrandRed}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText"
                                       Text="Ready"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11.5"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Border x:Name="UpdateBadge"
                                    Visibility="Collapsed"
                                    Background="#26F59E0B"
                                    BorderBrush="#66F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="7,1.5"
                                    Margin="10,0,0,0"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="UpdateBadge_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Update " Foreground="#FBBF24" FontSize="10.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="UpdateVersionText" Text="v2.3.2" Foreground="#FDE68A" FontSize="10.5" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Quiet Keycaps -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PrimaryActionLabel"
                                       Text="Open"
                                       Foreground="#CBD5E1"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Border Background="{StaticResource GlassChipFill}"
                                    BorderBrush="{StaticResource GlassChipBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="6,1.5"
                                    Margin="0,0,12,0"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="PrimaryAction_Click">
                                <TextBlock Text="↵" Foreground="#F8FAFC" FontSize="10.5" FontWeight="Bold" />
                            </Border>

                            <TextBlock Text="Actions" Foreground="{StaticResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border Background="{StaticResource GlassChipFill}"
                                    BorderBrush="{StaticResource GlassChipBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="6,1.5"
                                    Margin="0,0,10,0"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="ActionsButton_Click">
                                <TextBlock Text="Ctrl K" Foreground="#CBD5E1" FontSize="10.5" FontWeight="Medium" />
                            </Border>

                            <Border Background="{StaticResource GlassChipFill}"
                                    BorderBrush="{StaticResource GlassChipBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,1.5"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="SettingsButton_Click">
                                <TextBlock Text="⚙" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- LAYER 2: Ctrl + K Actions Glass Popover                                   -->
            <!-- ========================================================================= -->
            <Grid x:Name="ActionsOverlay"
                  Visibility="Collapsed"
                  Background="#2204060A"
                  MouseLeftButtonDown="ActionsOverlayBackdrop_Click">
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Width="340"
                        Margin="0,0,16,44"
                        Background="#780B0E16"
                        BorderBrush="{StaticResource GlassSpecularBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#07FFFFFF" BorderThickness="0,0,0,1" BorderBrush="#14FFFFFF" Padding="14,0">
                            <Grid VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource BrandRed}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Actions" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Esc" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ListBox x:Name="ActionsList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsTextSearchEnabled="False"
                                 Margin="4"
                                 SelectionMode="Single"
                                 PreviewMouseLeftButtonUp="ActionsList_PreviewMouseLeftButtonUp"
                                 MouseDoubleClick="ActionsList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="28" VerticalAlignment="Center" Margin="4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="2" Background="{StaticResource GlassChipFill}" BorderBrush="{StaticResource GlassChipBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShortcutHint}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ShortcutHint}" Foreground="#CBD5E1" FontSize="10.5" FontWeight="Medium" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Background="#1005070B" BorderThickness="0,1,0,0" BorderBrush="#14FFFFFF" Padding="14,0">
                            <TextBlock Text="↵ Execute  •  Ctrl+Shift+↵ Run as Admin" Foreground="{StaticResource TextMuted}" FontSize="10.5" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- LAYER 3: Frosted Glass Google Gemini Suite                                -->
            <!-- ========================================================================= -->
            <Grid x:Name="AiOverlay"
                  Visibility="Collapsed"
                  Background="#1606080D">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <!-- Minimal Frosted Header -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#14FFFFFF" Padding="18,0" Background="#06FFFFFF">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path VerticalAlignment="Center" Margin="0,0,10,0" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource BrandRed}" Data="M 0,8 L 8,0 L 16,8 L 8,16 Z" />
                            <TextBlock Text="AI Assistant" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="AiModelTag" Text="" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource GlassChipFill}" BorderBrush="{StaticResource GlassChipBorder}" BorderThickness="1" CornerRadius="7" Padding="10,4" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="NewGeminiChat_Click">
                                <TextBlock Text="New Chat" Foreground="#CBD5E1" FontSize="11" FontWeight="Medium" />
                            </Border>
                            <Border Background="{StaticResource GlassChipFill}" BorderBrush="{StaticResource GlassChipBorder}" BorderThickness="1" CornerRadius="7" Padding="10,4" Cursor="Hand" MouseLeftButtonDown="CloseAiOverlay_Click">
                                <TextBlock Text="Esc" Foreground="#94A3B8" FontSize="11" FontWeight="Medium" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Body Area -->
                <Grid Grid.Row="1">
                    <!-- Native AI Streaming View -->
                    <Grid x:Name="GeminiApiChatContainer" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="ApiChatScrollViewer" Grid.Row="0" Padding="18,14" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <StackPanel x:Name="ApiChatHistoryPanel" />

                                <Border Background="#0CFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                                    <TextBlock x:Name="AiUserPromptText" Text="Ask anything..." Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Border>
                                <Border Background="#08FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                    <TextBlock x:Name="AiResponseText" Text="" Foreground="{StaticResource TextPrimary}" FontSize="13.5" LineHeight="21" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1" Background="#0C06080D" BorderThickness="0,1,0,0" BorderBrush="#14FFFFFF" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#12FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                                    <TextBox x:Name="AiPromptInputBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FocusVisualStyle="{x:Null}"
                                             Foreground="#FFFFFF"
                                             CaretBrush="{DynamicResource BrandRed}"
                                             FontSize="13"
                                             KeyDown="AiPromptInputBox_KeyDown" />
                                </Border>

                                <Border Grid.Column="1" Background="{DynamicResource BrandRed}" CornerRadius="8" Padding="14,6" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="SendApiChatPrompt_Click">
                                    <TextBlock Text="Send" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Border>

                                <Border Grid.Column="2" Background="{StaticResource GlassChipFill}" BorderBrush="{StaticResource GlassChipBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Cursor="Hand" MouseLeftButtonDown="CopyAiResponse_Click">
                                    <TextBlock Text="Copy" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Bottom Status Strip -->
                <Border Grid.Row="2" Background="#1205070B" BorderThickness="0,1,0,0" BorderBrush="#14FFFFFF" Padding="18,0">
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="AiStatusText" Text="Gemini Ready" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="Esc to return" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- LAYER 4: Minimalist Glass Preferences Overlay                             -->
            <!-- ========================================================================= -->
            <Grid x:Name="SettingsOverlay"
                  Visibility="Collapsed"
                  Background="#1406080D">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>

                <!-- Row 0: Frosted Glass Header & Segmented Pill Navigation -->
                <Border Grid.Row="0" Background="#06FFFFFF" BorderThickness="0,0,0,1" BorderBrush="#14FFFFFF" Padding="20,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path VerticalAlignment="Center" Margin="0,0,9,0" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource BrandRed}" Data="M 0,8 L 8,0 L 16,8 L 8,16 Z" />
                            <TextBlock Text="Preferences" Foreground="#F8FAFC" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="1" HorizontalAlignment="Center" Background="#10FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="SetTabGeneral" Background="#20FFFFFF" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="6" Padding="11,4" Margin="0,0,2,0" Cursor="Hand" MouseLeftButtonDown="SettingsTab_Click" Tag="General">
                                    <TextBlock x:Name="SetTabGeneralTxt" Text="General" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" />
                                </Border>
                                <Border x:Name="SetTabAppearance" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="11,4" Margin="0,0,2,0" Cursor="Hand" MouseLeftButtonDown="SettingsTab_Click" Tag="Appearance">
                                    <TextBlock x:Name="SetTabAppearanceTxt" Text="Appearance" Foreground="#94A3B8" FontSize="11.5" />
                                </Border>
                                <Border x:Name="SetTabModules" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="11,4" Margin="0,0,2,0" Cursor="Hand" MouseLeftButtonDown="SettingsTab_Click" Tag="Modules">
                                    <TextBlock x:Name="SetTabModulesTxt" Text="Extensions" Foreground="#94A3B8" FontSize="11.5" />
                                </Border>
                                <Border x:Name="SetTabAi" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="11,4" Margin="0,0,2,0" Cursor="Hand" MouseLeftButtonDown="SettingsTab_Click" Tag="AI">
                                    <TextBlock x:Name="SetTabAiTxt" Text="AI" Foreground="#94A3B8" FontSize="11.5" />
                                </Border>
                                <Border x:Name="SetTabData" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="11,4" Cursor="Hand" MouseLeftButtonDown="SettingsTab_Click" Tag="Data">
                                    <TextBlock x:Name="SetTabDataTxt" Text="Storage" Foreground="#94A3B8" FontSize="11.5" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource GlassChipFill}" BorderBrush="{StaticResource GlassChipBorder}" BorderThickness="1" CornerRadius="7" Padding="10,4" Cursor="Hand" MouseLeftButtonDown="CloseSettingsOverlay_Click">
                            <TextBlock Text="Esc" Foreground="#94A3B8" FontSize="11" FontWeight="Medium" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Row 1: Glass Tab Content Area -->
                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Padding="22,16" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- TAB 1: GENERAL (Windows Key Activation Only) -->
                        <StackPanel x:Name="SettingsTabGeneralPanel" Visibility="Visible">
                            <TextBlock Text="ACTIVATION &amp; STARTUP" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,8" />

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,11" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Windows Key Activation" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Open Kestrel with a solo tap of the Windows key" Foreground="#94A3B8" FontSize="11.5" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkStartKeyTrigger" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,11" Margin="0,0,0,16">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Launch at Login" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Start silently in the system tray when Windows starts" Foreground="#94A3B8" FontSize="11.5" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkLaunchStartup" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <TextBlock Text="BEHAVIOR" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,8" />

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,11" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Dismiss on Outside Click" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Automatically hide when focus moves to another window" Foreground="#94A3B8" FontSize="11.5" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkHideOutside" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,11" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="HUD Notifications" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Show subtle confirmation pills for actions" Foreground="#94A3B8" FontSize="11.5" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkToastNotifications" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,11" Margin="0,0,0,16">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Low-Memory Background Mode" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Trim working set memory when idle in system tray" Foreground="#94A3B8" FontSize="11.5" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkTrimMemory" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <TextBlock Text="UPDATES" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,8" />

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,11">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,160,0">
                                            <TextBlock Text="Software Updates" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                            <TextBlock x:Name="TxtUpdateStatus" Text="Kestrel is up to date (v2.4.1)" Foreground="#94A3B8" FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border x:Name="BtnCancelUpdate" Visibility="Collapsed" Background="{StaticResource GlassChipFill}" BorderBrush="{StaticResource GlassChipBorder}" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="CancelUpdate_Click">
                                                <TextBlock Text="Cancel" Foreground="#94A3B8" FontSize="11.5" FontWeight="Medium" />
                                            </Border>
                                            <Border x:Name="BtnCheckUpdates" Background="{StaticResource GlassChipFill}" BorderBrush="{StaticResource GlassChipBorder}" BorderThickness="1" CornerRadius="7" Padding="12,5" Cursor="Hand" MouseLeftButtonDown="CheckUpdates_Click">
                                                <TextBlock x:Name="BtnCheckUpdatesText" Text="Check for Updates" Foreground="#F8FAFC" FontSize="11.5" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="UpdateProgressContainer" Visibility="Collapsed" Margin="0,10,0,0">
                                        <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" Background="#1AFFFFFF" BorderThickness="0">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                                                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" />
                                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource BrandRed}" />
                                                        <Border x:Name="IndeterminatePulse" Visibility="Collapsed" Opacity="0.85" CornerRadius="3" Background="{DynamicResource BrandRed}" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsIndeterminate" Value="True">
                                                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="IndeterminatePulse" Property="Visibility" Value="Visible" />
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard x:Name="PulseStoryboard">
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetName="IndeterminatePulse"
                                                                                         Storyboard.TargetProperty="Opacity"
                                                                                         From="0.35" To="0.95" Duration="0:0:0.65" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                                                            </Trigger.ExitActions>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                        <Grid Margin="0,5,0,0">
                                            <TextBlock x:Name="TxtUpdateStage" Text="Preparing update..." Foreground="#CBD5E1" FontSize="11" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="TxtUpdateBytes" Text="" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 2: APPEARANCE & CUSTOMIZATION -->
                        <StackPanel x:Name="SettingsTabAppearancePanel" Visibility="Collapsed">
                            <TextBlock Text="WINDOW TRANSPARENCY" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,8" />

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,70,0">
                                            <TextBlock Text="Background Opacity" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                            <TextBlock Text="Adjust frosted acrylic transparency of the launcher" Foreground="#94A3B8" FontSize="11.5" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="TxtOpacityValue" Text="40%" Foreground="#F8FAFC" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="SliderBgOpacity"
                                            Minimum="0.25"
                                            Maximum="1.0"
                                            Value="0.40"
                                            SmallChange="0.05"
                                            LargeChange="0.10"
                                            TickFrequency="0.05"
                                            IsSnapToTickEnabled="True"
                                            IsMoveToPointEnabled="True"
                                            Margin="0,12,0,4"
                                            ValueChanged="SliderBgOpacity_ValueChanged" />
                                    <Grid>
                                        <TextBlock Text="25% Clear Glass" Foreground="#64748B" FontSize="10.5" HorizontalAlignment="Left" />
                                        <TextBlock Text="100% Solid Dark" Foreground="#64748B" FontSize="10.5" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="THEME ACCENT COLOR" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,8" />

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,13">
                                <StackPanel>
                                    <TextBlock Text="Accent Color" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="Choose a preset or enter a custom #RRGGBB hex color" Foreground="#94A3B8" FontSize="11.5" Margin="0,1,0,0" />

                                    <StackPanel x:Name="ThemeSwatchesPanel" Orientation="Horizontal" Margin="0,12,0,12">
                                        <Border x:Name="SwatchCoral" Width="26" Height="26" CornerRadius="13" Background="#FF6363" BorderBrush="#FFFFFFFF" BorderThickness="2" Margin="0,0,10,0" Cursor="Hand" ToolTip="Coral (#FF6363)" Tag="#FF6363" MouseLeftButtonDown="ThemeSwatch_Click" />
                                        <Border x:Name="SwatchBlue" Width="26" Height="26" CornerRadius="13" Background="#3B82F6" BorderBrush="#33FFFFFF" BorderThickness="2" Margin="0,0,10,0" Cursor="Hand" ToolTip="Electric Blue (#3B82F6)" Tag="#3B82F6" MouseLeftButtonDown="ThemeSwatch_Click" />
                                        <Border x:Name="SwatchEmerald" Width="26" Height="26" CornerRadius="13" Background="#10B981" BorderBrush="#33FFFFFF" BorderThickness="2" Margin="0,0,10,0" Cursor="Hand" ToolTip="Emerald (#10B981)" Tag="#10B981" MouseLeftButtonDown="ThemeSwatch_Click" />
                                        <Border x:Name="SwatchViolet" Width="26" Height="26" CornerRadius="13" Background="#8B5CF6" BorderBrush="#33FFFFFF" BorderThickness="2" Margin="0,0,10,0" Cursor="Hand" ToolTip="Violet (#8B5CF6)" Tag="#8B5CF6" MouseLeftButtonDown="ThemeSwatch_Click" />
                                        <Border x:Name="SwatchAmber" Width="26" Height="26" CornerRadius="13" Background="#F59E0B" BorderBrush="#33FFFFFF" BorderThickness="2" Margin="0,0,10,0" Cursor="Hand" ToolTip="Amber (#F59E0B)" Tag="#F59E0B" MouseLeftButtonDown="ThemeSwatch_Click" />
                                        <Border x:Name="SwatchRose" Width="26" Height="26" CornerRadius="13" Background="#F43F5E" BorderBrush="#33FFFFFF" BorderThickness="2" Margin="0,0,10,0" Cursor="Hand" ToolTip="Rose (#F43F5E)" Tag="#F43F5E" MouseLeftButtonDown="ThemeSwatch_Click" />
                                        <Border x:Name="SwatchCyan" Width="26" Height="26" CornerRadius="13" Background="#06B6D4" BorderBrush="#33FFFFFF" BorderThickness="2" Cursor="Hand" ToolTip="Cyan (#06B6D4)" Tag="#06B6D4" MouseLeftButtonDown="ThemeSwatch_Click" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtThemeHex" Grid.Column="0" Background="#12FFFFFF" Foreground="#FFFFFF" CaretBrush="{DynamicResource BrandRed}" BorderBrush="#26FFFFFF" BorderThickness="1" FocusVisualStyle="{x:Null}" Padding="10,6" FontSize="12.5" MaxLength="7" />
                                        <Border Grid.Column="1" Background="{StaticResource GlassChipFill}" BorderBrush="{StaticResource GlassChipBorder}" BorderThickness="1" CornerRadius="7" Padding="14,6" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonDown="ApplyCustomThemeHex_Click">
                                            <TextBlock Text="Apply" Foreground="#F8FAFC" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="2" Background="{StaticResource GlassChipFill}" BorderBrush="{StaticResource GlassChipBorder}" BorderThickness="1" CornerRadius="7" Padding="12,6" Margin="6,0,0,0" Cursor="Hand" MouseLeftButtonDown="ResetAppearance_Click">
                                            <TextBlock Text="Reset Default" Foreground="#94A3B8" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 3: EXTENSIONS -->
                        <StackPanel x:Name="SettingsTabModulesPanel" Visibility="Collapsed">
                            <TextBlock Text="BUILT-IN EXTENSIONS" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,8" />

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Gemini AI" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Embedded AI assistant and clipboard writing tools" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableAi" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="File Search" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Instant local file indexing (Ctrl+F)" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableFileSearch" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Clipboard History" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Event-driven clipboard history and instant paste (Ctrl+Shift+V)" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableClipboard" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Window Management" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Desktop snapping layouts with multi-monitor support" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableWindowSnap" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Calculator &amp; Converter" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Inline math expressions, units, currency, and timezones" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableCalculator" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Process Manager" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Inspect active processes by memory and terminate unresponsive tasks" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableProcessKiller" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="System Commands" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Power controls, audio, dark mode, elevated terminals, and generators" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableSystemCmds" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Web Search Fallbacks" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Quick web search options for Google, YouTube, and GitHub" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableWebFallbacks" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Memory Reduct Engine" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Safe Smart Reclaim working-set optimizer, Memory Reduct Studio (Ctrl+M), and optional kernel purge" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnableMemReduct" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="Auto Memory Reduct (Sustained Pressure)" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Automatically run Smart Reclaim only after 30s+ of sustained high RAM pressure with cooldowns" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkAutoMemReduct" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,10">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                                        <TextBlock Text="PowerToys &amp; Developer Utilities" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Color Picker, Screen OCR, Awake, Port Inspector (Ctrl+P), JWT/Color/Hash/Timer evaluators" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChkEnablePowerTools" Style="{StaticResource RaycastSwitchStyle}" HorizontalAlignment="Right" Click="SettingToggle_Changed" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- TAB 3: AI -->
                        <StackPanel x:Name="SettingsTabAiPanel" Visibility="Collapsed">
                            <TextBlock Text="PROVIDER &amp; API KEY" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,8" />

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="ProviderPillGemini" Grid.Column="0" Background="#20FFFFFF" BorderBrush="#FF6363" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="ProviderPill_Click" Tag="gemini">
                                            <TextBlock x:Name="ProviderPillGeminiTxt" Text="Gemini" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="ProviderPillOpenAi" Grid.Column="1" Background="#0CFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="ProviderPill_Click" Tag="openai">
                                            <TextBlock x:Name="ProviderPillOpenAiTxt" Text="OpenAI" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="ProviderPillGroq" Grid.Column="2" Background="#0CFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="ProviderPill_Click" Tag="groq">
                                            <TextBlock x:Name="ProviderPillGroqTxt" Text="Groq" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="ProviderPillAnthropic" Grid.Column="3" Background="#0CFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,6" Cursor="Hand" MouseLeftButtonDown="ProviderPill_Click" Tag="anthropic">
                                            <TextBlock x:Name="ProviderPillAnthropicTxt" Text="Claude" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="TxtActiveProviderKeyLabel" Text="API Key" Foreground="#94A3B8" FontSize="11.5" Margin="2,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtApiKeyOverride" Grid.Column="0" Background="#12FFFFFF" Foreground="#FFFFFF" CaretBrush="{DynamicResource BrandRed}" BorderBrush="#26FFFFFF" BorderThickness="1" FocusVisualStyle="{x:Null}" Padding="10,7" FontSize="12.5" TextChanged="TxtApiKeyOverride_TextChanged" />
                                        <Border Grid.Column="1" Background="{StaticResource GlassChipFill}" BorderBrush="{StaticResource GlassChipBorder}" BorderThickness="1" CornerRadius="7" Padding="12,7" Margin="6,0,0,0" Cursor="Hand" MouseLeftButtonDown="SaveKeyLocally_Click">
                                            <TextBlock x:Name="TxtSaveLocalKeyBtn" Text="Save" Foreground="#F8FAFC" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="2" Background="#2210B981" BorderBrush="#4410B981" BorderThickness="1" CornerRadius="7" Padding="12,7" Margin="6,0,0,0" Cursor="Hand" MouseLeftButtonDown="SaveKeyToSupabase_Click">
                                            <TextBlock x:Name="TxtSaveVaultBtn" Text="Sync Vault" Foreground="#6EE7B7" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="3" Background="#22EF4444" BorderBrush="#44EF4444" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="6,0,0,0" Cursor="Hand" MouseLeftButtonDown="ClearProviderKey_Click">
                                            <TextBlock Text="Clear" Foreground="#FCA5A5" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="CONFIGURATION" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,8" />

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="Custom Model ID (Optional)" Foreground="#94A3B8" FontSize="11.5" Margin="2,0,0,6" />
                                    <Grid Margin="0,0,0,14">
                                        <TextBox x:Name="TxtAiModel" Background="#12FFFFFF" Foreground="#FFFFFF" CaretBrush="{DynamicResource BrandRed}" BorderBrush="#26FFFFFF" BorderThickness="1" FocusVisualStyle="{x:Null}" Padding="10,7" FontSize="12.5" />
                                        <TextBlock Text="Enter custom model identifier..."
                                                   Foreground="#64748B"
                                                   FontSize="12.5"
                                                   Padding="12,8"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtAiModel}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <TextBlock Text="Cloud Backend Endpoint" Foreground="#94A3B8" FontSize="11.5" Margin="2,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtCloudUrl" Grid.Column="0" Background="#12FFFFFF" Foreground="#FFFFFF" CaretBrush="{DynamicResource BrandRed}" BorderBrush="#26FFFFFF" BorderThickness="1" FocusVisualStyle="{x:Null}" Padding="10,7" FontSize="12.5" />
                                        <Border Grid.Column="1" Background="{StaticResource GlassChipFill}" BorderBrush="{StaticResource GlassChipBorder}" BorderThickness="1" CornerRadius="7" Padding="14,7" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonDown="TestCloudHealth_Click">
                                            <TextBlock x:Name="TxtTestCloudBtn" Text="Test" Foreground="#F8FAFC" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 4: STORAGE & INDEX -->
                        <StackPanel x:Name="SettingsTabDataPanel" Visibility="Collapsed">
                            <TextBlock Text="INDEX SUMMARY" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,8" />

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                                <TextBlock x:Name="TxtIndexStats"
                                           Text="Loading index telemetry..."
                                           Foreground="#CBD5E1"
                                           FontSize="12.5"
                                           LineHeight="22" />
                            </Border>

                            <TextBlock Text="MAINTENANCE" Foreground="{StaticResource TextMuted}" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,8" />

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,11" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Rebuild Search Index" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Rescan applications and local user directories" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="{StaticResource GlassChipFill}" BorderBrush="{StaticResource GlassChipBorder}" BorderThickness="1" CornerRadius="7" Padding="12,5" Cursor="Hand" MouseLeftButtonDown="RebuildIndex_Click">
                                        <TextBlock Text="Rebuild" Foreground="#F8FAFC" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,11" Margin="0,0,0,6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Clear Clipboard History" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Remove all stored clipboard items from memory and disk" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#22EF4444" BorderBrush="#44EF4444" BorderThickness="1" CornerRadius="7" Padding="12,5" Cursor="Hand" MouseLeftButtonDown="ClearClipboardHistory_Click">
                                        <TextBlock Text="Clear" Foreground="#FCA5A5" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource GlassCardFill}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="16,11">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Reset Search Ranking" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Reset learned command usage weights to defaults" Foreground="#94A3B8" FontSize="11.5" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="{StaticResource GlassChipFill}" BorderBrush="{StaticResource GlassChipBorder}" BorderThickness="1" CornerRadius="7" Padding="12,5" Cursor="Hand" MouseLeftButtonDown="ResetFrecency_Click">
                                        <TextBlock Text="Reset" Foreground="#F8FAFC" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Row 2: Minimal Frosted Footer -->
                <Border Grid.Row="2" Background="#1205070B" BorderThickness="0,1,0,0" BorderBrush="#14FFFFFF" CornerRadius="0,0,16,16" Padding="20,0">
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="SettingsSavedNotice" Text="Kestrel v2.4.1 • Noventra-Labs" Foreground="{StaticResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NoventraLink_Click" ToolTip="https://github.com/Noventra-labs/Kestrel" />
                        <Border HorizontalAlignment="Right"
                                Background="{DynamicResource BrandRed}"
                                CornerRadius="7"
                                Padding="16,5"
                                Cursor="Hand"
                                MouseLeftButtonDown="SaveSettings_Click">
                            <TextBlock Text="Done" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- LAYER 5: Celebratory Confetti Canvas Overlay                              -->
            <!-- ========================================================================= -->
            <Canvas x:Name="ConfettiCanvas" IsHitTestVisible="False" ClipToBounds="True" />
        </Grid>
    </Border>
</Window>
