<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Kestrel</AssemblyName>
    <RootNamespace>Kestrel</RootNamespace>
    <ApplicationIcon>kestrel.ico</ApplicationIcon>
    <Version>2.4.1</Version>
    <FileVersion>2.4.1.0</FileVersion>
    <AssemblyVersion>2.4.1.0</AssemblyVersion>
    <Company>Noventra-Labs</Company>
    <Authors>Noventra-Labs</Authors>
    <Product>Kestrel</Product>
    <AssemblyTitle>Kestrel Launcher by Noventra-Labs</AssemblyTitle>
    <Copyright>Copyright © 2026 Noventra-Labs. All rights reserved.</Copyright>
    <Description>High-Definition Raycast for Windows Clone by Noventra-Labs</Description>
    <RepositoryUrl>https://github.com/Noventra-labs/Kestrel</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Noventra-labs/Kestrel</PackageProjectUrl>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="kestrel.ico" />
  </ItemGroup>

  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
    <PublishReadyToRunExclude Include="WinRT.Runtime.dll" />
  </ItemGroup>

</Project>
