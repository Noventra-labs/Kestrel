<Window x:Class="KestrelInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kestrel Setup"
        Width="440" Height="270"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Icon="kestrel.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="MinimalCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D1D5DB" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="BoxBorder"
                                    Width="15" Height="15"
                                    CornerRadius="3.5"
                                    Background="#161922"
                                    BorderBrush="#32394A"
                                    BorderThickness="1"
                                    Margin="0,0,9,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Width="9" Height="7"
                                      Stretch="Uniform"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M 1,4 L 4,7 L 9,1"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FF6363" />
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF6363" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FF8080" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0F1117"
            BorderBrush="#222634"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <!-- Top Title Bar -->
            <Border Grid.Row="0"
                    Background="#0C0E13"
                    BorderBrush="#1A1E29"
                    BorderThickness="0,0,0,1"
                    Padding="14,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="Kestrel Setup" Foreground="#9CA3AF" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right"
                            Width="22" Height="22"
                            CornerRadius="4"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseLeftButtonDown="BtnSecondary_Click">
                        <TextBlock Text="✕" Foreground="#6B7280" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- Center Content Area -->
            <Grid Grid.Row="1" Margin="20,14,20,12">

                <!-- VIEW 1: SETUP -->
                <StackPanel x:Name="PageSetup" Visibility="Visible">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Kestrel" Foreground="#F9FAFB" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="v2.4.1" Foreground="#6B7280" FontSize="11.5" Margin="8,0,0,1" VerticalAlignment="Bottom" />
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtInstallDir"
                                 Grid.Column="0"
                                 Background="#151821"
                                 Foreground="#D1D5DB"
                                 CaretBrush="#FF6363"
                                 BorderBrush="#242A38"
                                 BorderThickness="1"
                                 Padding="8,5"
                                 FontSize="11.5" />
                        <Border Grid.Column="1"
                                Background="#1B202C"
                                BorderBrush="#2D3446"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10,5"
                                Margin="6,0,0,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="BrowseFolder_Click">
                            <TextBlock Text="Browse" Foreground="#E5E7EB" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <StackPanel>
                        <CheckBox x:Name="OptLaunchOnBoot"
                                  Style="{StaticResource MinimalCheckBoxStyle}"
                                  Content="Start at Windows sign-in"
                                  Margin="0,0,0,7"
                                  IsChecked="True" />

                        <CheckBox x:Name="OptConfigureWinHook"
                                  Style="{StaticResource MinimalCheckBoxStyle}"
                                  Content="Enable Windows key shortcut"
                                  Margin="0,0,0,7"
                                  IsChecked="True" />

                        <CheckBox x:Name="OptCreateShortcuts"
                                  Style="{StaticResource MinimalCheckBoxStyle}"
                                  Content="Create Desktop &amp; Start Menu shortcuts"
                                  IsChecked="True" />
                    </StackPanel>
                </StackPanel>

                <!-- VIEW 2: INSTALLING -->
                <StackPanel x:Name="PageInstalling" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                    <TextBlock x:Name="InstallingHeaderTitle"
                               Text="Installing Kestrel..."
                               Foreground="#F9FAFB"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4" />

                    <TextBlock x:Name="InstallingStepLabel"
                               Text="Preparing files..."
                               Foreground="#9CA3AF"
                               FontSize="11.5"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,14" />

                    <Border Width="340"
                            Height="4"
                            CornerRadius="2"
                            Background="#191D28"
                            BorderThickness="0"
                            ClipToBounds="True"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8">
                        <Border x:Name="InstallProgressFill"
                                HorizontalAlignment="Left"
                                Width="0"
                                Height="4"
                                CornerRadius="2"
                                Background="#FF6363" />
                    </Border>

                    <TextBlock x:Name="InstallPercentText"
                               Text="0%"
                               Foreground="#6B7280"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />

                    <Border x:Name="FailureDetailBox"
                            Visibility="Collapsed"
                            Background="#151821"
                            BorderBrush="#2B3142"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,10,0,0">
                        <TextBlock x:Name="FailureDiagnosticText"
                                   Text="Click 'Retry &amp; Auto-Fix' to resolve conflicts and finish setup."
                                   Foreground="#9CA3AF"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- VIEW 3: COMPLETE -->
                <StackPanel x:Name="PageComplete" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                    <TextBlock Text="Installation complete"
                               Foreground="#F9FAFB"
                               FontSize="15"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6" />

                    <TextBlock x:Name="CompleteSummaryText"
                               Text="Press the Windows key anytime to open Kestrel."
                               Foreground="#9CA3AF"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <CheckBox x:Name="ChkLaunchNow"
                              Style="{StaticResource MinimalCheckBoxStyle}"
                              Content="Launch Kestrel now"
                              HorizontalAlignment="Center"
                              IsChecked="True" />
                </StackPanel>
            </Grid>

            <!-- Bottom Action Bar -->
            <Border Grid.Row="2" Background="#0C0E13" BorderBrush="#1C202B" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="Noventra-Labs" Foreground="#6B7280" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NoventraLink_Click" ToolTip="https://github.com/Noventra-labs/Kestrel" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border x:Name="BtnSecondary"
                                Background="#171B24"
                                BorderBrush="#282F3E"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12,5"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="BtnSecondary_Click">
                            <TextBlock x:Name="TxtSecondaryBtn" Text="Cancel" Foreground="#9CA3AF" FontSize="11.5" FontWeight="Medium" />
                        </Border>

                        <Border x:Name="BtnPrimary"
                                Background="#FF6363"
                                CornerRadius="5"
                                Padding="16,5"
                                Cursor="Hand"
                                MouseLeftButtonDown="BtnPrimary_Click">
                            <TextBlock x:Name="TxtPrimaryBtn" Text="Install" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
