<Window x:Class="Beam.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kestrel Color Picker"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove">

    <Canvas x:Name="OverlayCanvas" Background="#01000000">
        <!-- Floating Magnifier Loupe -->
        <Border x:Name="LoupeContainer"
                Width="140" Height="175"
                CornerRadius="16"
                Background="#EE1A1F2C"
                BorderBrush="#44FFFFFF"
                BorderThickness="1.5"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.55" Color="#000000" />
            </Border.Effect>

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Magnified Pixel Grid -->
                <Border Grid.Row="0"
                        CornerRadius="10"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                        <Image x:Name="MagnifierImage"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />

                        <!-- Center Reticle Crosshair -->
                        <Rectangle Width="10" Height="10"
                                   Stroke="#FFFFFF"
                                   StrokeThickness="1.5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Rectangle Width="12" Height="12"
                                   Stroke="#000000"
                                   StrokeThickness="0.8"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Color Swatch & Hex Code -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                x:Name="ColorSwatch"
                                Width="16" Height="16"
                                CornerRadius="4"
                                Background="#FF6363"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   x:Name="HexCodeText"
                                   Text="#FF6363"
                                   FontFamily="Segoe UI Variable Text, Consolas, monospace"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#FFFFFF"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="RgbCodeText"
                               Text="rgb(255, 99, 99)"
                               FontFamily="Segoe UI Variable Text, Consolas, monospace"
                               FontSize="11"
                               Foreground="#9CA3AF"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Tip -->
                <TextBlock Grid.Row="2"
                           Text="Click: Copy • Esc: Close"
                           FontSize="10"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </Grid>
        </Border>
    </Canvas>
</Window>
