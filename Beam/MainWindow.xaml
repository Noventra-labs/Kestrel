                                    <TextBlock x:Name="TxtSaveVaultBtn" Text="☁ Sync Supabase" Foreground="#6EE7B7" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="3" Background="#3A2026" BorderBrush="#6E323E" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="6,0,0,0" Cursor="Hand" MouseLeftButtonDown="ClearProviderKey_Click">
                                    <TextBlock Text="🗑" Foreground="#FCA5A5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- TAB 4: STORAGE, CACHE & INDEX MAINTENANCE -->
                        <StackPanel x:Name="SettingsTabDataPanel" Visibility="Collapsed">
                            <TextBlock Text="LIVE INDEX &amp; STORAGE TELEMETRY" Foreground="{StaticResource BrandRed}" FontSize="11" FontWeight="Bold" Margin="2,0,0,10" />

                            <Border Background="#1A1D26" BorderBrush="#2A303E" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                                <TextBlock x:Name="TxtIndexStats"
                                           Text="Loading index telemetry..."
                                           Foreground="#E5E7EB"
                                           FontSize="13"
                                           LineHeight="22" />
                            </Border>

                            <TextBlock Text="MAINTENANCE &amp; PRIVACY ACTIONS" Foreground="{StaticResource BrandRed}" FontSize="11" FontWeight="Bold" Margin="2,0,0,10" />

                            <Border Background="#1A1D26" BorderBrush="#2A303E" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Rebuild Application &amp; Local File Index" Foreground="#F9FAFB" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Text="Rescan Start Menu, Desktop, Downloads, Documents, and Projects immediately" Foreground="#9CA3AF" FontSize="11.5" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#252C3D" BorderBrush="#3B455E" BorderThickness="1" CornerRadius="6" Padding="12,5" Cursor="Hand" MouseLeftButtonDown="RebuildIndex_Click">
                                        <TextBlock Text="↻ Rebuild Index" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="#1A1D26" BorderBrush="#2A303E" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Clear Saved Clipboard History" Foreground="#F9FAFB" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Text="Remove all stored clipboard entries from memory and %APPDATA%\Beam" Foreground="#9CA3AF" FontSize="11.5" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#3A2026" BorderBrush="#6E323E" BorderThickness="1" CornerRadius="6" Padding="12,5" Cursor="Hand" MouseLeftButtonDown="ClearClipboardHistory_Click">
                                        <TextBlock Text="🗑 Clear Clips" Foreground="#FCA5A5" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="#1A1D26" BorderBrush="#2A303E" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Reset Frecency Search Learning" Foreground="#F9FAFB" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock Text="Reset learned command usage counts and ranking weights to factory defaults" Foreground="#9CA3AF" FontSize="11.5" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#252C3D" BorderBrush="#3B455E" BorderThickness="1" CornerRadius="6" Padding="12,5" Cursor="Hand" MouseLeftButtonDown="ResetFrecency_Click">
                                        <TextBlock Text="↺ Reset Ranking" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Row 3: Settings Footer Bar -->
                <Border Grid.Row="3" Background="#101216" BorderThickness="0,1,0,0" BorderBrush="#222631" Padding="18,0">
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="SettingsSavedNotice" Text="Beam v2.3.0 • Published by Noventra Labs • All toggles auto-save" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                        <Border HorizontalAlignment="Right"
                                Background="{StaticResource BrandRed}"
                                CornerRadius="6"
                                Padding="16,5"
                                Cursor="Hand"
                                MouseLeftButtonDown="SaveSettings_Click">
                            <TextBlock Text="Save &amp; Done" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- LAYER 5: Celebratory Confetti Canvas Overlay                              -->
            <!-- ========================================================================= -->
            <Canvas x:Name="ConfettiCanvas" IsHitTestVisible="False" ClipToBounds="True" />
        </Grid>
    </Border>
</Window>
