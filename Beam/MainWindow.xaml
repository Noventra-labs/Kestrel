<Window x:Class="Beam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Beam"
        Width="820" Height="550"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="beam.ico"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BrandRed" Color="#FF6363" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F9FAFB" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF" />
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280" />

        <!-- Sleek Thin Dark ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="6" Margin="0,4,2,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#384152" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Raycast Pill Toggle Switch Style -->
        <Style x:Key="RaycastSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="42" Height="22"
                                CornerRadius="11"
                                Background="#262C3A"
                                BorderBrush="#384154"
                                BorderThickness="1"
                                Padding="2">
                            <Ellipse x:Name="Knob"
                                     Width="16" Height="16"
                                     Fill="#9CA3AF"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF6363" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF8080" />
                                <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Raycast ListBoxItem Selection Style -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,1.5,8,1.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="10,6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#282F3D" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3B4458" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#16FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Flush Outer Shell Container (Windows 11 Acrylic Glass Background) -->
    <Border x:Name="MainShellBorder"
            CornerRadius="12"
            Background="#D012151D"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <!-- ========================================================================= -->
            <!-- LAYER 1: Main Launcher Interface                                          -->
            <!-- ========================================================================= -->
            <Grid x:Name="LauncherView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />   <!-- 0: Search Bar Header -->
                    <RowDefinition Height="36" />   <!-- 1: Category Filter Pills & Section Header -->
                    <RowDefinition Height="*" />    <!-- 2: Results ListBox -->
                    <RowDefinition Height="42" />   <!-- 3: Bottom Status Bar -->
                </Grid.RowDefinitions>

                <!-- Row 0: Search Bar Header (Frosted Glass Divider) -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#1AFFFFFF" Background="#300F1218">
                    <Grid Margin="18,0,18,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Glowing Raycast/Beam Diamond Icon OR Back Button -->
                        <Border x:Name="BackButtonBorder"
                                Grid.Column="0"
                                Visibility="Collapsed"
                                Background="#232834"
                                BorderBrush="#363D4E"
                                BorderThickness="1"
                                CornerRadius="6"
                                Width="28" Height="28"
                                Margin="0,0,10,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="BackButton_Click">
                            <TextBlock Text="←" Foreground="#E5E7EB" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                        </Border>

                        <Path x:Name="BrandLogoPath"
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"
                              Width="20" Height="20"
                              Stretch="Uniform"
                              Fill="{StaticResource BrandRed}"
                              Cursor="Hand"
                              MouseLeftButtonDown="BrandLogo_Click"
                              Data="M 0,10 L 10,0 L 20,10 L 10,20 Z M 4.5,10 L 10,4.5 L 15.5,10 L 10,15.5 Z">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#FF6363" Opacity="0.8" />
                            </Path.Effect>
                        </Path>

                        <!-- Active Sub-View Mode Pill -->
                        <Border x:Name="ActiveModePill"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Background="#26FF6363"
                                BorderBrush="#66FF6363"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,3"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveModeText"
                                       Text="Clipboard"
                                       Foreground="#FF8585"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>

                        <!-- Search Input Box -->
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="PlaceholderText"
                                       Text="Search apps, 'powershell', commands, window snap, math, or files..."
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="17.5"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Margin="2,0,0,0" />
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     CaretBrush="{StaticResource BrandRed}"
                                     FontSize="17.5"
                                     FontWeight="Normal"
                                     VerticalAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"
                                     AcceptsReturn="False" />
                        </Grid>

                        <!-- Right: Quick Gemini AI Badge -->
                        <Border x:Name="QuickAiBadgeBorder"
                                Grid.Column="3"
                                Background="#351F2432"
                                BorderBrush="#45FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,4"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                MouseLeftButtonDown="QuickAiBadge_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✦ Gemini AI"
                                           Foreground="#E5E7EB"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <Border Background="#2D3446"
                                        CornerRadius="4"
                                        Padding="5,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Tab"
                                               Foreground="#FF8585"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Row 1: Section Label & Category Filter Pills -->
                <Grid Grid.Row="1" Margin="18,0,18,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SectionHeaderText"
                               Grid.Column="0"
                               Text="Suggestions &amp; Results"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <!-- Interactive Filter Tabs -->
                    <StackPanel x:Name="FilterTabsPanel"
                                Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border x:Name="TabAll" Background="#282F3D" CornerRadius="5" Padding="8,2" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="FilterTab_Click" Tag="All">
                            <TextBlock Text="All" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" />
                        </Border>
                        <Border x:Name="TabApps" Background="Transparent" CornerRadius="5" Padding="8,2" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="FilterTab_Click" Tag="Application">
                            <TextBlock Text="Apps" Foreground="#9CA3AF" FontSize="11.5" />
                        </Border>
                        <Border x:Name="TabCommands" Background="Transparent" CornerRadius="5" Padding="8,2" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="FilterTab_Click" Tag="Command">
                            <TextBlock Text="Commands" Foreground="#9CA3AF" FontSize="11.5" />
                        </Border>
                        <Border x:Name="TabWindows" Background="Transparent" CornerRadius="5" Padding="8,2" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="FilterTab_Click" Tag="Window Management">
                            <TextBlock Text="Window Snap" Foreground="#9CA3AF" FontSize="11.5" />
                        </Border>
                        <Border x:Name="TabSystem" Background="Transparent" CornerRadius="5" Padding="8,2" Cursor="Hand" MouseLeftButtonDown="FilterTab_Click" Tag="System">
                            <TextBlock Text="System" Foreground="#9CA3AF" FontSize="11.5" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Results List -->
                <ListBox x:Name="ResultsList"
                         Grid.Row="2"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionMode="Single"
                         SelectionChanged="ResultsList_SelectionChanged"
                         PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
                         MouseDoubleClick="ResultsList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="36" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- High-DPI App or Squircle Vector Icon -->
                                <Image Grid.Column="0"
                                       Source="{Binding Icon}"
                                       Width="26" Height="26"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <!-- Item Title -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0" />

                                <!-- Inline Subtitle / Path -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Subtitle}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12.5"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Margin="12,0,14,0" />

                                <!-- Optional Shortcut Pill Badge -->
                                <Border Grid.Column="3"
                                        Background="#222734"
                                        BorderBrush="#32394A"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShortcutBadge}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ShortcutBadge}"
                                               Foreground="#D1D5DB"
                                               FontSize="11"
                                               FontWeight="Medium" />
                                </Border>

                                <!-- Right-Aligned Category Label -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding Category}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Row 3: Bottom Status Bar (Frosted Glass Footer) -->
                <Border Grid.Row="3"
                        Background="#350E1117"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#1AFFFFFF"
                        CornerRadius="0,0,12,12"
                        Padding="18,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Status Indicator -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="12" Height="12"
                                  Stretch="Uniform"
                                  Fill="{StaticResource BrandRed}"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Data="M 0,6 L 6,0 L 12,6 L 6,12 Z" />
                            <TextBlock x:Name="StatusText"
                                       Text="Beam Ready • Press Start Key or Alt+Space anytime"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Right Action Hints -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PrimaryActionLabel"
                                       Text="Open"
                                       Foreground="#D1D5DB"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Border Background="#242936"
                                    BorderBrush="#383F52"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,1"
                                    Margin="0,0,12,0"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="PrimaryAction_Click">
                                <TextBlock Text="↵" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                            </Border>

                            <TextBlock Text="|" Foreground="#353B49" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <TextBlock Text="Actions" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border Background="#242936"
                                    BorderBrush="#383F52"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="0,0,12,0"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="ActionsButton_Click">
                                <TextBlock Text="Ctrl K" Foreground="#E5E7EB" FontSize="11" FontWeight="Medium" />
                            </Border>

                            <TextBlock Text="|" Foreground="#353B49" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <Border Background="#242936"
                                    BorderBrush="#383F52"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="7,2"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="SettingsButton_Click">
                                <TextBlock Text="⚙ Settings" Foreground="#E5E7EB" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- LAYER 2: Ctrl + K Actions Modal Overlay (Frosted Glass Acrylic Card)       -->
            <!-- ========================================================================= -->
            <Grid x:Name="ActionsOverlay"
                  Visibility="Collapsed"
                  Background="#55000000"
                  MouseLeftButtonDown="ActionsOverlayBackdrop_Click">
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Width="390"
                        Margin="0,0,18,48"
                        Background="#E0141720"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#300F1218" BorderThickness="0,0,0,1" BorderBrush="#1AFFFFFF" Padding="14,0">
                            <Grid VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource BrandRed}" Margin="0,0,7,0" Data="M12,2 L20,6 V12 C20,17 16,21 12,22 C8,21 4,17 4,12 V6 Z" />
                                    <TextBlock Text="ACTIONS" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Esc to Close" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ListBox x:Name="ActionsList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="4"
                                 SelectionMode="Single"
                                 PreviewMouseLeftButtonUp="ActionsList_PreviewMouseLeftButtonUp"
                                 MouseDoubleClick="ActionsList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="32" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" Margin="4,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="2" Background="#252A36" BorderBrush="#383E4E" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding ShortcutHint}" Foreground="#D1D5DB" FontSize="11" FontWeight="Medium" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Background="#250C0E14" BorderThickness="0,1,0,0" BorderBrush="#1AFFFFFF" Padding="14,0">
                            <TextBlock Text="Press Enter or click to execute • Ctrl+Shift+↵ to run as Admin" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- LAYER 3: Embedded Google Gemini Chat Suite (WebView2 + Multi-Turn API)    -->
            <!-- ========================================================================= -->
            <Grid x:Name="AiOverlay"
                  Visibility="Collapsed"
                  Background="#F814161B">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Gemini Header & Mode Switcher -->
                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#252A36" Padding="16,0" Background="#111318">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Brand Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path VerticalAlignment="Center" Margin="0,0,10,0" Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource BrandRed}" Data="M 0,8 L 8,0 L 16,8 L 8,16 Z" />
                            <TextBlock Text="Google Gemini Chat" Foreground="{StaticResource TextPrimary}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="AiModelTag" Text="(Embedded Web)" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Center Mode Switcher Pill -->
                        <Border Grid.Column="1" HorizontalAlignment="Center" Background="#1A1E28" BorderBrush="#2E3546" BorderThickness="1" CornerRadius="7" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="BtnGeminiWebMode" Background="#FF6363" CornerRadius="5" Padding="10,3" Cursor="Hand" MouseLeftButtonDown="SwitchToGeminiWebMode_Click">
                                    <TextBlock x:Name="TxtGeminiWebMode" Text="✦ Gemini Web (gemini.google.com)" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" />
                                </Border>
                                <Border x:Name="BtnGeminiApiMode" Background="Transparent" CornerRadius="5" Padding="10,3" Cursor="Hand" MouseLeftButtonDown="SwitchToGeminiApiMode_Click">
                                    <TextBlock x:Name="TxtGeminiApiMode" Text="⚡ Fast API Stream" Foreground="#9CA3AF" FontSize="11.5" FontWeight="Medium" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Right Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1F2430" BorderBrush="#32394A" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="NewGeminiChat_Click">
                                <TextBlock Text="↻ New Chat" Foreground="#D1D5DB" FontSize="11.5" />
                            </Border>
                            <Border Background="#1F2430" BorderBrush="#32394A" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="OpenGeminiInBrowser_Click">
                                <TextBlock Text="↗ Browser" Foreground="#D1D5DB" FontSize="11.5" />
                            </Border>
                            <Border Background="#242936" BorderBrush="#383F52" BorderThickness="1" CornerRadius="5" Padding="9,3" Cursor="Hand" MouseLeftButtonDown="CloseAiOverlay_Click">
                                <TextBlock Text="← Back (Esc)" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Body Area: Hosts Either Embedded WebView2 OR Multi-Turn Native API Stream -->
                <Grid Grid.Row="1">
                    <!-- Mode 1: Embedded Google Gemini Web App (Inset by 8px to avoid HWND corner bleed) -->
                    <Border x:Name="GeminiWebViewContainer"
                            Visibility="Collapsed"
                            Margin="8,6,8,8"
                            CornerRadius="8"
                            Background="#131314"
                            BorderBrush="#2A303E"
                            BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="GeminiWebLoadingText"
                                       Text="Loading Google Gemini (gemini.google.com)..."
                                       Foreground="#9CA3AF"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <wv2:WebView2 x:Name="GeminiWebView"
                                          Visibility="Collapsed"
                                          Margin="2" />
                        </Grid>
                    </Border>

                    <!-- Mode 2: Multi-Turn Fast API Streaming Chat -->
                    <Grid x:Name="GeminiApiChatContainer" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="ApiChatScrollViewer" Grid.Row="0" Padding="20,14" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Dynamic History Thread -->
                                <StackPanel x:Name="ApiChatHistoryPanel" />

                                <!-- Current Active Exchange -->
