                                        <TextBlock Text="Remove all stored clipboard items from memory and disk" Foreground="#6B7280" FontSize="11.5" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#2A1B20" BorderBrush="#4C2932" BorderThickness="1" CornerRadius="6" Padding="12,5" Cursor="Hand" MouseLeftButtonDown="ClearClipboardHistory_Click">
                                        <TextBlock Text="Clear" Foreground="#FCA5A5" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="#151821" BorderBrush="#222735" BorderThickness="1" CornerRadius="8" Padding="16,11">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Reset Search Ranking" Foreground="#F3F4F6" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="Reset learned command usage weights to defaults" Foreground="#6B7280" FontSize="11.5" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#1F2533" BorderBrush="#31394D" BorderThickness="1" CornerRadius="6" Padding="12,5" Cursor="Hand" MouseLeftButtonDown="ResetFrecency_Click">
                                        <TextBlock Text="Reset" Foreground="#F3F4F6" FontSize="11.5" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Row 2: Minimal Footer -->
                <Border Grid.Row="2" Background="#0D0F14" BorderThickness="0,1,0,0" BorderBrush="#1E222D" Padding="20,0">
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="SettingsSavedNotice" Text="Kestrel v2.3.1 • Noventra Labs" Foreground="#6B7280" FontSize="11.5" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="NoventraLink_Click" ToolTip="https://github.com/Noventra-labs/Kestrel" />
                        <Border HorizontalAlignment="Right"
                                Background="{StaticResource BrandRed}"
                                CornerRadius="6"
                                Padding="16,5"
                                Cursor="Hand"
                                MouseLeftButtonDown="SaveSettings_Click">
                            <TextBlock Text="Done" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- LAYER 5: Celebratory Confetti Canvas Overlay                              -->
            <!-- ========================================================================= -->
            <Canvas x:Name="ConfettiCanvas" IsHitTestVisible="False" ClipToBounds="True" />
        </Grid>
    </Border>
</Window>
